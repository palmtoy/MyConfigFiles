
unalias g 2>/dev/null

function g() {
  if [ "$1" = "stash" ] && [ "$2" = "list" ]; then
    git stash list | cat
  elif [ "$1" = "stash" ] && [ "$2" = "-u" ]; then
    shift 2
    git stash -u "$@" | cat
  elif [ "$1" = "stash" ] && [ "$2" = "pop" ] && printf '%s' "$3" | grep -Eq '^[0-9]+$'; then
    git stash pop "$3" | cat
  elif [ "$1" = "stash" ] && [ "$2" = "apply" ] && printf '%s' "$3" | grep -Eq '^[0-9]+$'; then
    git stash apply "$3" | cat
  else
    git "$@"
  fi
}

function gstash() {
	if [[ $# -ne 1 ]]; then
		echo "Please input the stash name ( just 1 parameter ) ..."
	else
		# git stash push -m "$1"
		git stash -u -m "$1"
	fi
}

function gstashapply() {
	if [[ $# -ne 1 ]]; then
		echo "Please input the stash name ( just 1 parameter ) ..."
	else
		git stash apply $(git stash list | grep "$1" | cut -d: -f1)
	fi
}

