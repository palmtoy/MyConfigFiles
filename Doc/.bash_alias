# aliases
alias reloadbash="source ~/.bash_profile"

alias psn="ps aux | grep node -w"

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias cd-="cd -"
alias cde="cd /c/MyDisc/GitHub/Exercise/Nodejs"
alias cdd="cd $HOME/Downloads"
alias cdm="cd $HOME/LabOfGit/muses-desktop"

alias n="node"
alias c="clear"

alias ls="ls --show-control-chars --color=auto"
alias l="ls"
alias la="ls -lah"
alias ll="la"
alias lm='ll | more'
alias lsd='ls -d *(/)'
alias df='df -h'
alias du='du -h -d1'
alias cp='cp -iR'
alias tf='tail -f'

alias mv='mv -i'
alias rm='rm -ivr'
alias md='mkdir -p'
alias ztar='tar -czvf'
alias uztar='tar -xzvf'
alias ubz2tar='tar -jvxf'
alias ttar='tar -tvf'
alias man='man -a'
alias vi='vim'
alias mvi='gvim'

alias gitk='gitk.exe'
alias gk='gitk'
alias ga='git add --ignore-removal'
alias gsu='git submodule update'


alias myip='ipconfig | grep inet\ '

