alias dk='docker'
alias dki='docker images'
alias dkp='docker ps -a'
alias dke='docker exec -it'
alias dkc='docker-compose'
alias dcu='docker-compose up -d'
alias dcd='docker-compose down'

alias rc='redis-cli'

alias j='java'
alias mp='mvn package'
alias jsh='jshell'

alias rmongo='cd /tmp; mkdir -p /tmp/log; sleep 1; pkill mongo; sleep 2; rm -rf /data/db/mongod.lock; sleep 2; mongod --dbpath /data/db > /tmp/log/mongo.log&; sleep 1; cd -'
alias rredis='pushd /opt/redis/current/bin; ./boot-redis-cluster.sh; popd'
alias rdb='rredis'
alias sdb='rdb'

alias cdmysql="cd /opt/mysql-8.0.35-arm64"
alias rmysql='pushd /opt/mysql-8.0.35-arm64; ./boot-mysqld.sh; popd'
# alias dkmysql="docker run --platform linux/amd64 --name mysqld-5.7.40 -e MYSQL_ROOT_PASSWORD=******* -v ~/Workspace/Data/mysql-5.7.40-x64/data:/var/lib/mysql -p 33306:3306 -d mysql:5.7.40"
alias dkmysql="docker run --platform linux/amd64 --name mysqld-5.7.40 -v ~/Workspace/Data/mysql-5.7.40-x64/data:/var/lib/mysql -p 33306:3306 -d mysql:5.7.40"
alias dkes='docker run -d --name elasticsearch -p 39200:9200 -e "discovery.type=single-node" -v ~/Workspace/Data/es/data:/usr/share/elasticsearch/data -v ~/Workspace/Data/es/plugins:/usr/share/elasticsearch/plugins docker.elastic.co/elasticsearch/elasticsearch:7.12.1'

alias aispd="curl -s \"${ANTHROPIC_BASE_URL}key/info\" -H \"Authorization: Bearer $ANTHROPIC_AUTH_TOKEN\" | jq '.info | {key_alias, spend, budget_reset_at}'"

# alias f='nvm use v8.16.1; sleep 0.5; stf local'
alias cainit='source $HOME/.conda_init; sleep 0.5; conda activate python39; sleep 0.5'
alias f='condainit; nvm use; sleep 0.5; stf local'
alias ft='cd /var/folders/45/86qtmmt925x9wbsdqdgxnh7r0000gn/T'

alias calv='source $HOME/.conda_init; sleep 0.5; conda activate lv-similarity; sleep 0.5'

alias tailf='tail -f'
alias tf='tail -f'
alias sls='screen -ls'
alias sr='screen -R'
alias py='python3'
alias am='aws-mfa'
alias k='kubectl'
alias kex='k exec -itn'  # kex bgp-qa turbo-server-865***fdf-v***f -- sh

alias m='make'
alias getesp8266="export PATH=$HOME/esp/xtensa-lx106-elf/bin:$PATH; export IDF_PATH=$HOME/esp/ESP8266_RTOS_SDK"
alias getidf='. $HOME/esp/esp-idf/export.sh'
alias i='idf.py'
alias ib='i build'
alias im='i menuconfig'
alias ia='i build flash monitor'
alias ifm='i flash monitor'

