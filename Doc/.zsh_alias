# aliases
alias reloadzsh="exec zsh && source ~/.zshrc"

alias slp="sleep 0.3; pmset displaysleepnow; sleep 1; pmset sleepnow"

alias psn="ps aux | grep node -w"
alias psr="ps aux | grep redis-server -w"
alias mtl="multitail ~/.ssh/srv-log/error.log ~/.ssh/srv-log/running.log.*"
alias ct="clear_trash.scpt"
alias cs="clear_screen.scpt"
alias 7z="7zz"

alias n="node"
alias nv="node -v"

alias cdf="cd $HOME/Workspace/LabOfGit/BGP/MTFarm/backend-server-mtf"

alias cdd="cd ~/Downloads"
alias cdm="cd ~/Library/Application\ Support/MusesDesktop"
alias cde="cd ~/Exercise"
alias cdt="cd $HOME/GitHub/yew/examples/todomvc"
alias cdnx="cd /usr/local/etc/nginx"

alias ....="cd ../../.."
alias .....="cd ../../../.."
alias cd-="cd -"
alias l="ls"
alias la="ls -lah"
alias ll="la"
alias llt="ll -t"
alias lm='ll | more'
alias lsd='ls -d *(/)'
alias df='df -h'
alias du='du -h -d1'
alias cp='cp -iR'
# alias cat='cat -n'
alias c='clear'

alias mv='mv -i'
alias rm='rm -ivr'
alias md='mkdir -p'
alias ztar='tar -czvf'
alias uztar='tar -xzvf'
alias ubz2tar='tar -jvxf'
alias ttar='tar -tvf'
alias man='man -a'
alias vi='vim'
alias mvi='gvim'

alias gitk='/opt/homebrew/Cellar/git-gui/2.43.0/bin/gitk'
alias gk='gitk 2>/dev/null'
alias ga='git add --ignore-removal'
alias gsu='git submodule update'
alias gcz='git add .; git cz'
alias gs='git status'

# Example aliases
